; ===== Core feature toggles =====
; These three are the original merged modules. Every OTHER feature (notes,
; sketchbook, calculator, study outlook, contact sheet, report, gauge,
; watermark, log...) has its own 'enabled' key in its own section below.
; Bottom-right success-counters overlay.
[features]
success_counters = true
; Save photos taken with the in-game camera to the DCIM folder.
functional_camera = true
; Flashlight/camera battery + OS-coin overlay.
inventory_overlay = true

; ===== Overlay style =====
; 0 = auto-size by resolution, otherwise a pixel font size.
[overlay]
font_size = 0
; Hex RRGGBB. Normal counter text.
text_color = FFFFFF
; Hex RRGGBB. Counter text once a category is fully complete.
complete_color = 00FF00
; Hex RRGGBB. Map-name title and inventory labels.
title_color = 666666
; Window background opacity: 0.0 (clear) .. 1.0 (opaque).
background_alpha = 0.30
; Gap in px between the overlays and the screen edges.
margin = 10
; Anchor corner: top-left | top-right | bottom-left | bottom-right
counters_corner = bottom-right
inventory_corner = top-left
; native = squared/bordered HUD style; debug = plain ImGui look.
theme = native
; Show the 'SILTA - Bind keys' button on the MAIN MENU (press-to-capture rebinder
; that records the real key you press - fixes binds on non-US layouts).
bind_wizard_button_menu = true
; Also show it IN-GAME at the pause menu (ESC). Off by default.
bind_wizard_button_ingame = false
; Button position (px, top-left origin). -1 = auto (bottom-left, over the version).
bind_wizard_button_x = -1
bind_wizard_button_y = -1
toggle_menu = Insert
; Log current map + player position (ZONE-MARK line + toast) - for collecting
; coordinates, e.g. to define [radiation_zones]
; ============================ RADIATION ZONES ============================
; Hand-placed radiation volumes for maps where the game's geiger can't tell SILTA
; where the radiation is. Inside a zone, photos get radiation grain (needs
; photo_radiation_noise = true); outside every zone they're clean. Any map with at
; least one zone turns OFF the '~random on name-matched maps' fallback for it.
;
; Up to 64 zones (zone1..zone64), each a SPHERE or a BOX keyed to a map fragment:
;   SPHERE: zoneN = <map> <x> <y> <z> <radius> [strength] [ramp_sec]
;   BOX:    zoneN = <map> box <x1> <y1> <z1> <x2> <y2> <z2> [strength] [ramp_sec]
;
;   map       part of the map name (e.g. 'reactor' matches infra_c10_m2_reactor)
;   x y z     sphere CENTER, world units (a big room is ~500-1000 across)
;   radius    sphere radius in units
;   x1..z2    two opposite box CORNERS (any order)
;   strength  optional 0..1 grain for this zone; overrides radiation_noise_strength
;   ramp_sec  optional; if > 0 exposure BUILDS over cumulative in-zone time (~20%
;             on entry, full after this many seconds; pauses when you leave, resets
;             per map). Omit = instant.
;
; Optional companion, one per zone:
;   zoneN_trigger = <x> <y> <z> <radius>
;     Zone stays ASLEEP until the player first touches this sphere, then arms for
;     the rest of the map.
;
; Collect coordinates in-game: bind [hotkeys] mark_position, stand on the spot,
; press it -> a ZONE-MARK line (map + x y z) goes to silta.log. Mark box corners,
; or a center + a wall for a sphere radius.
;
; Defaults below: reactor (turbine hall box, wakes at a trigger then ramps ~5 min;
; + the chamber beneath it) and bunker (lab / demon core / uranium hangar).
zone1 = reactor box -540 -395 -135 710 400 545 0.7 300
zone1_trigger = -136 527 34 120
zone2 = reactor 7 -3 -1080 250 1.0
; Bunker laboratory (demon core room), the demon core itself, and the uranium
; hangar - all surveyed in-game.
zone3 = bunker box -7443 -3414 -104 -6820 -2997 52 0.85
zone4 = bunker -6927 -3295 -43 90 1.0
zone5 = bunker box -6676 -4437 -435 -6057 -2863 -181 0.8

[radiation_ambient]
; =========================== AMBIENT RADIATION ==========================
; Map-wide random radiation baseline, applied everywhere the player is NOT inside
; a [radiation_zones] volume. For maps that are radioactive all over.
;   <map_fragment> = <base 0..1> [variance 0..1]
;   base      center grain for every photo on the map
;   variance  optional random swing: each photo picks base +/- variance (0..1)
; Precedence: inside a zone -> zone wins; outside -> this ambient; zone-map with no
; ambient entry -> clean outside its zones.
roof = 0.35 0.3
wasteland = 0.8 0.2
bunker = 0.2 0.15

